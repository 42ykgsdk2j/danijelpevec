---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Chat from "../../../components/Chat.tsx";
import RelatedPosts from "../../../components/RelatedPosts.astro";
import { getT, url, SITE } from "../../../lib/i18n";
import { langOf, slugOf, translationKeyOf } from "../../../content.config";
import { blogPostingJsonLd, faqPageJsonLd } from "../../../lib/seo";
import { extractFaq } from "../../../lib/faq";

export async function getStaticPaths() {
  const all = await getCollection("blog");
  const posts = all.filter((entry) => langOf(entry.id) === "en");
  return posts.map((p) => {
    // The HR version (if any) shares this post's translationKey but has
    // its own slug in its own language — look it up rather than assuming.
    const key = translationKeyOf(p);
    const twin = all.find((e) => langOf(e.id) === "hr" && translationKeyOf(e) === key);
    return {
      params: { slug: slugOf(p.id) },
      props: { post: p, twinSlug: twin ? slugOf(twin.id) : null },
    };
  });
}

const { post, twinSlug } = Astro.props;
const { Content } = await render(post);
const lang = "en" as const;
const t = getT(lang);
const slug = slugOf(post.id);
const enUrl = `${SITE}/en/blog/${slug}/`;
// Only advertise an HR alternate when the translation actually exists.
const hrUrl = twinSlug ? `${SITE}/blog/${twinSlug}/` : undefined;
// Nav language toggle: the HR twin, or the HR blog index as the nearest page.
const altUrl = twinSlug ? url("hr", `blog/${twinSlug}`) : url("hr", "blog");
function fmtDate(iso: string) {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });
}
const allInsightsLabel = t.blog.viewAll;
const faqJsonLd = faqPageJsonLd(extractFaq(post.body), lang, enUrl);
const jsonLd = [blogPostingJsonLd(post.data, lang, enUrl), ...(faqJsonLd ? [faqJsonLd] : [])];
---
<BaseLayout
  lang={lang}
  title={`${post.data.title} | Danijel Pevec`}
  description={post.data.excerpt}
  canonical={enUrl}
  hreflangEn={enUrl}
  hreflangHr={hrUrl}
  altUrl={altUrl}
  ogType="article"
  jsonLd={jsonLd}
>
  <header class="article-header reveal in">
    <div class="container">
      <a href={url(lang, "blog")} class="blog-back"><span class="arr">→</span> {allInsightsLabel}</a>
      <div class="article-meta-row">
        <span class="cat">{post.data.category}</span>
        <span class="dot">·</span>
        <time class="article-date" datetime={post.data.date}>{fmtDate(post.data.date)}</time>
        {post.data.updated && (
          <>
            <span class="dot">·</span>
            <span class="article-updated">{t.blog.updated} <time datetime={post.data.updated}>{fmtDate(post.data.updated)}</time></span>
          </>
        )}
        <span class="dot">·</span>
        <span class="readtime">{post.data.readTime} {t.blog.minRead}</span>
      </div>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-deck">{post.data.excerpt}</p>
      <div class="article-byline"><span class="author-mono">DP</span><span class="who">Author: <strong>Danijel Pevec</strong> · Family Business Advisor</span></div>
    </div>
  </header>
  {post.data.cover && (
    <figure class="article-cover">
      <div class="container">
        <img src={post.data.cover} alt={post.data.coverAlt ?? post.data.title} loading="lazy" />
      </div>
    </figure>
  )}
  <article class="article-body">
    <div class="container">
      <Content />
    </div>
  </article>
  <RelatedPosts post={post} lang={lang} />
  <Chat
    client:idle
    mode="blog"
    contextTitle={post.data.title}
    contextBody={post.body}
    lang={lang}
    ui={t.blogChat}
  />
</BaseLayout>
