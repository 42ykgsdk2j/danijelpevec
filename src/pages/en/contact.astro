---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactStudio from "../../components/ContactStudio.tsx";
import { BUSINESS, SITE, getT, url } from "../../lib/i18n";

const lang = "en" as const;
const t = getT(lang);
const hasRecaptcha = !!process.env.RECAPTCHA_SITE_KEY;
---
<BaseLayout
  lang={lang}
  title={t.contactPage.metaTitle}
  description={t.contactPage.metaDescription}
  canonical={`${SITE}/en/contact/`}
  hreflangEn={`${SITE}/en/contact/`}
  hreflangHr={`${SITE}/kontakt/`}
  altUrl="/kontakt/"
>
  <ContactStudio
    client:load
    lang={lang}
    ui={t.contactPage}
    modalUi={t.modal}
    email={BUSINESS.email}
    homeHref={url(lang)}
    hasRecaptcha={hasRecaptcha}
  />
</BaseLayout>
